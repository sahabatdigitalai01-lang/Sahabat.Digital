# Google Gemini API Keys (Bisa pasang 1 atau lebih key untuk melipatgandakan kuota)
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Port Server
PORT=3000

# Web Push Notification (VAPID Keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@sahabatdigital.id
